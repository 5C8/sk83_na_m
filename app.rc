// Game artwork is loaded from the user-provided game files at runtime.

// Same version block as skate3recomp's src/skate3.rc.in (which fills it from
// CMake). Keep the numbers in step with project(... VERSION) in
// CMakeLists.txt, which also feeds the window title.
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Skate3Recomp project"
            VALUE "FileDescription", "Skate3Recomp"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "sk83_na_m"
            VALUE "LegalCopyright", "(c) Skate3Recomp contributors"
            VALUE "OriginalFilename", "sk83_na_m.exe"
            VALUE "ProductName", "Skate3Recomp"
            VALUE "ProductVersion", "1.0.0"
            VALUE "Comments", "Fan-made recompilation. Not affiliated with or endorsed by Electronic Arts."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
